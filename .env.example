# ==============================================================================
# VAULT Backend Environment Configuration
# ==============================================================================

# Application
VAULT_APP_NAME="VAULT Backend"
VAULT_APP_VERSION="0.1.0"
VAULT_ENVIRONMENT="development"
VAULT_DEBUG=false
VAULT_HOST="127.0.0.1"
VAULT_PORT=8000
VAULT_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# Offline Enforcement
VAULT_OFFLINE_MODE=true

# Database (SQLite by default, PostgreSQL through configuration)
# SQLite:
VAULT_DATABASE_URL="sqlite:///./vault.db"
# PostgreSQL example:
# VAULT_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/vault"
VAULT_DB_ECHO=false

# File Storage
VAULT_UPLOAD_DIR="./data/uploads"
VAULT_MAX_UPLOAD_SIZE_BYTES=52428800

# Local LLM Client
# Modes: "mock" (offline mock response), "ollama" (local Ollama), "local_api" (local vLLM / llama.cpp)
VAULT_LLM_MODE="mock"
VAULT_LLM_ENDPOINT="http://127.0.0.1:11434"
VAULT_LLM_MODEL="llama3:8b"
VAULT_LLM_TIMEOUT_SECONDS=30.0

# Logging
VAULT_LOG_LEVEL="INFO"
VAULT_LOG_FORMAT="json"
